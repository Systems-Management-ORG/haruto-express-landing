# Read at build time. Rebuild after changing either value.

# Leave unset until launch: every page is served with noindex.
# Set to "true" only when the content is complete and the JA/EN translations are reviewed.
ALLOW_INDEXING=

# The public origin, for example https://www.example.com.
# Needed for og:image, which must be an absolute URL. Without it the tag is left out.
SITE_URL=

# Google Tag Manager container ID. Defaults to GTM-PL7NKB8J when unset.
# Set to an empty value to disable analytics loading (for example in previews).
NEXT_PUBLIC_GTM_ID=

# Contact form → Google Sheet (server-side only; see docs/LEADS-GOOGLE-SHEET.md).
# LEADS_WEBHOOK_URL is the Apps Script web app URL (https://script.google.com/macros/s/.../exec).
# LEADS_WEBHOOK_SECRET is a random string whose SHA-256 is SECRET_SHA256 in leads.gs. Without both, the form
# answers "could not send" and points visitors to Zalo / the fanpage.
LEADS_WEBHOOK_URL=
LEADS_WEBHOOK_SECRET=
