# Server deployment only (docker-compose.yml): staging or production. Names the stack and its
# container haruto-<DEPLOY_ENV>-landing; the deploy refuses a directory whose value does not match the tag.
# Release tags, server layout and rollback: the Backend's docs/04-runbooks/DEPLOYMENT.md.
DEPLOY_ENV=

# Read at build time. Rebuild after changing any value. The deploy copies these keys
# (ALLOW_INDEXING, SITE_URL, NEXT_PUBLIC_GTM_ID, NEXT_PUBLIC_LOGIN_ENABLED, NEXT_PUBLIC_AUTH_PORTAL_URL)
# from the server .env into the build when present.

# Leave unset until launch: every page is served with noindex.
# Set to "true" only when the content is complete and the JA/EN translations are reviewed.
ALLOW_INDEXING=

# The public origin, for example https://www.example.com.
# Needed for og:image, which must be an absolute URL. Without it the tag is left out.
SITE_URL=

# Google Tag Manager container ID. Defaults to GTM-PL7NKB8J when unset.
# Set to an empty value to disable analytics loading (for example in previews).
NEXT_PUBLIC_GTM_ID=

# Switch for the header's "sign in" button: "true" shows it, and it opens the auth-portal in a modal iframe.
# Any other value hides it. NEXT_PUBLIC_AUTH_PORTAL_URL is the portal's origin (local: http://localhost:5174); the
# portal's FRAME_ANCESTORS must list this site's origin, or the browser refuses to show it.
NEXT_PUBLIC_LOGIN_ENABLED=false
NEXT_PUBLIC_AUTH_PORTAL_URL=

# Contact form → Google Sheet (server-side only; see docs/LEADS-GOOGLE-SHEET.md).
# LEADS_WEBHOOK_URL is the Apps Script web app URL (https://script.google.com/macros/s/.../exec).
# LEADS_WEBHOOK_SECRET is a random string whose SHA-256 is SECRET_SHA256 in leads.gs. Without both, the form
# answers "could not send" and points visitors to Zalo / the fanpage.
LEADS_WEBHOOK_URL=
LEADS_WEBHOOK_SECRET=
